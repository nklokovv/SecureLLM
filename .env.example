PORT=3000
NODE_ENV=development

MONGODB_URI=mongodb://mongo:27017/securellm
REDIS_URL=redis://redis:6379

# OpenAI — service starts without it; /v1/chat returns 503, healthz flags provider
OPENAI_API_KEY=

# Default rate limit (requests per minute) for keys without override
DEFAULT_RATE_LIMIT=30

# PII token vault TTL in Redis (seconds)
TOKEN_VAULT_TTL_SECONDS=3600

# Seed script defaults (optional)
SEED_CLIENT_KEY=client-dev-key-change-me
SEED_ADMIN_KEY=admin-dev-key-change-me
